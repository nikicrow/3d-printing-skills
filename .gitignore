# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Stray flat outputs at the repo root (generators now auto-file into
# previews/<tool>/ and printable_files/<tool>/, which ARE tracked). These
# patterns just catch anything written to the root by mistake.
/preview_*.png
/roller_*.stl
/roller_*.3mf
/stamp_*.stl
/scraper_*.stl
/scraper_*.3mf
.runtime_tapping/
.tennis-runtime/
*.log
.worktrees/

# Vendored pip installs (e.g. `pip install --target lib ...` used to give
# Blender's embedded Python access to numpy/trimesh/etc). These are large,
# platform-specific binary installs — build them locally, never commit them.
**/lib/
*.exe
*.dll
*.pyd
*.whl
*.dylib